# Local development only. On EC2 everything comes from SSM Parameter Store.
DATABASE_URL=postgresql+psycopg://pitwall:pitwall@localhost:5433/pitwall
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:5000
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
S3_BUCKET=pitwall
SQS_QUEUE_URL=http://localhost:5000/123456789012/pitwall-jobs
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:pitwall-notifications
JWT_SECRET=local-dev-secret
PUBLIC_URL=http://localhost:5173
SERVE_REPORTS_LOCALLY=true
